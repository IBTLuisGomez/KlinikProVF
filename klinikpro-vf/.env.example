# Variables de entorno del backend (klinikpro-vf). Copia este archivo a .env
# y llena los valores reales — .env está en .gitignore, nunca se sube.
# En dev local, si no defines estas variables, application.yml usa los
# defaults de siempre (klinik/klinik_dev, el secreto JWT de ejemplo) para
# que `mvn spring-boot:run` siga funcionando sin configurar nada.

# --- Base de datos ---
DB_URL=jdbc:postgresql://localhost:5433/klinikpro
DB_USERNAME=klinik
DB_PASSWORD=klinik_dev

# --- JWT ---
# OBLIGATORIO cambiar en producción: cadena aleatoria de 64+ caracteres.
# Genera una con, por ejemplo: openssl rand -base64 48
JWT_SECRET=CAMBIA_ESTO_por_una_cadena_larga_de_al_menos_64_caracteres_aleatorios_1234567890
JWT_EXPIRATION_MS=86400000

# --- CORS ---
# Orígenes del frontend permitidos, separados por coma. Agrega aquí el
# dominio real cuando el frontend se despliegue fuera de localhost.
CORS_ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:3000,http://localhost:5173
